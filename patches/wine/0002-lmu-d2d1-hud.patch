+static void d2d_device_context_push_layer_impl(ID2D1DeviceContext6 *iface,
+        const D2D1_LAYER_PARAMETERS1 *parameters, ID2D1Layer *layer_iface)
+{
+    struct d2d_device_context *context = impl_from_ID2D1DeviceContext(iface);
+    D2D1_BITMAP_PROPERTIES1 desc = {0};
+    struct d2d_layer *layer;
+    D2D1_SIZE_F size;
+    float dpi_x, dpi_y;
+    HRESULT hr;
+
+    size.width = context->pixel_size.width;
+    size.height = context->pixel_size.height;
+    if (layer_iface)
+    {
+        layer = unsafe_impl_from_ID2D1Layer(layer_iface);
+        ID2D1Layer_AddRef(layer_iface);
+    }
+    else if (FAILED(hr = d2d_layer_create(context->factory, &size, &layer)))
+    {
+        d2d_device_context_set_error(context, hr);
+        return;
