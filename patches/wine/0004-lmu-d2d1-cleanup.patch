 #define D2D1_TINT_PROP_COLOR 0
+#define D2D1_TINT_PROP_CLAMP_OUTPUT 1
 
 enum d2d_brush_type
 {
@@ -132,7 +133,7 @@
     BOOL outline;
     BOOL is_arc;
     BOOL is_tinted;
-    BOOL pad;
+    BOOL clamp_tint;
     struct d2d_brush_cb colour_brush;
     struct d2d_brush_cb opacity_brush;
     D2D1_COLOR_F tint_colour;
@@ -468,6 +469,7 @@
     float dpi_y;
     D2D1_BITMAP_OPTIONS options;
     BOOL is_tinted;
+    BOOL clamp_tint;
     D2D1_COLOR_F tint_colour;
     struct d2d_clip_stack clip_stack;
 };
