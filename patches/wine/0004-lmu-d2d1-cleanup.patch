@@ -147,16 +155,25 @@
     if (FAILED(hr = ID2D1DeviceContext6_CreateBitmap(iface, context->pixel_size, NULL, 0,
             &desc, &layer->offscreen_bitmap)))
     {
+        ID2D1Image_Release(layer->previous_target);
+        layer->previous_target = NULL;
