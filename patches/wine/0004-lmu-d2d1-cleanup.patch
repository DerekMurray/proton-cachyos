+        if (layer->parameters.geometricMask) ID2D1Geometry_Release(layer->parameters.geometricMask);
+        if (layer->parameters.opacityBrush) ID2D1Brush_Release(layer->parameters.opacityBrush);
+        layer->parameters.geometricMask = NULL;
+        layer->parameters.opacityBrush = NULL;
+        ID2D1Bitmap1_Release(layer->offscreen_bitmap);
+        layer->offscreen_bitmap = NULL;
+        ID2D1Image_Release(layer->previous_target);
+        layer->previous_target = NULL;
         ID2D1Layer_Release(&layer->ID2D1Layer_iface);
     }
 }
@@ -2796,36 +2842,34 @@
     {
         ID2D1Image *input = NULL;
