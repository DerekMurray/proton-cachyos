Subject: [PATCH] d2d1: correct LMU layer composition, Tint scope and resource cleanup

Follow-up to the mixed-source LMU Direct2D integration.
Includes local Tint property support from GE11-6 commit
c8e04a85d940646c36c4d6d3ebeb889a5c1024cb.

--- a/dlls/d2d1/bitmap.c
+++ b/dlls/d2d1/bitmap.c
@@ -420,6 +420,7 @@
     bitmap->dpi_y = desc->dpiY;
     bitmap->options = desc->bitmapOptions;
     bitmap->is_tinted = FALSE;
+    bitmap->clamp_tint = FALSE;
     bitmap->tint_colour = (D2D1_COLOR_F){1.0f, 1.0f, 1.0f, 1.0f};
     if (!d2d_bitmap_clip_stack_init(&bitmap->clip_stack))
         WARN("Failed to initialize bitmap clip stack.\n");
--- a/dlls/d2d1/d2d1_private.h
+++ b/dlls/d2d1/d2d1_private.h
@@ -39,6 +39,7 @@
 /* Introduced in d2d1effects_2.h on Windows 10, but not yet exposed by Wine's headers. */
